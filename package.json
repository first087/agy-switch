  "version": "0.1.0",
  "description": "Manage multiple antigravity-cli oauth token accounts",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "agys": "index.ts"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "scripts": {
